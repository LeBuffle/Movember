# Keep the build context small and, above all, keep secrets out of it:
# anything copied into the context can end up in an image layer.

node_modules
.next
out
build
coverage

# Secrets — never in an image (CLAUDE.md §9)
.env
.env.*
!.env.example
*.pem
*.key

.git
.github
.gitignore

# Documentation and tooling: not needed to build or run the app
docs
.bmad-core
.claude
CLAUDE.md
README.md
tests

.DS_Store
*.log
