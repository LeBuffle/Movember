# DEFI Movember — server-side infrastructure variables
#
# On the VPS, copy this file to `deploy/.env` and fill it in.
# Application variables (Supabase, Stripe, Strava…) do NOT go here: they live
# in `deploy/.env.production` and `deploy/.env.staging`, built from the
# repository-root `.env.example`.
#
# Restrict these files on the server:
#   chmod 600 deploy/.env deploy/.env.production deploy/.env.staging
#
# None of them is ever committed.

# --- Domains --------------------------------------------------------------
# Both must have a DNS record pointing at this VPS before starting the stack,
# otherwise Traefik cannot obtain their certificates.
#
# APP_DOMAIN is the bare domain. `www.<APP_DOMAIN>` is served too and
# permanently redirected to it, so there is one canonical public address.
APP_DOMAIN=defi-movember.fr
STAGING_DOMAIN=staging.defi-movember.fr

# --- Traefik ---------------------------------------------------------------
# This VPS already runs Traefik, which owns ports 80 and 443 and holds the
# certificates for every project on the machine. We plug into it instead of
# running a second reverse proxy.
#
# Network Traefik is attached to. Check it with:
#   docker inspect n8n-traefik-1 --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
TRAEFIK_NETWORK=n8n_default
# Certificate resolver declared in Traefik's own configuration.
TRAEFIK_CERTRESOLVER=mytlschallenge

# --- Staging protection ---------------------------------------------------
# Staging runs against test payment keys and must never be publicly
# reachable.
#
# ⚠️ EVERY `$` IN THE HASH MUST BE DOUBLED TO `$$`.
#
# Docker Compose performs variable substitution on this file too, so a raw
# bcrypt hash gets silently mangled: `po:$2y$05$Xf9kLm...` is truncated to
# `po:$2y$05` because `$Xf9kLm...` is read as an (undefined) variable. The
# result is not an error — it is an authentication that can never succeed.
#
# Generate the value with the doubling already applied:
#   docker run --rm httpd:alpine htpasswd -nbB po 'mot-de-passe-choisi' | sed -e 's/\$/\$\$/g'
#
# Expected shape: user:$$2y$$05$$...  (one line, no space)
STAGING_BASIC_AUTH=

# --- Images ---------------------------------------------------------------
# Set by the deployment pipeline (story 1.3) to the published image tag.
# Left empty locally, the stack builds from source instead.
APP_IMAGE=
STAGING_IMAGE=
APP_VERSION=
STAGING_APP_VERSION=

# --- Alerting (story 1.11) -------------------------------------------------
# Where `deploy/scripts/check-resources.sh` sends its disk and memory
# warnings. Any URL that accepts a JSON POST: an n8n webhook — this VPS
# already runs n8n — a Discord or Slack webhook, or an e-mail relay.
#
# A webhook rather than mail on purpose: a VPS with no mail server silently
# drops what it sends, which is the worst property an alerting channel can
# have. It looks like it works right until the night it matters.
#
# Left empty, the script still writes its warnings to the system log; it just
# cannot reach a phone.
ALERT_WEBHOOK_URL=

# --- Content Security Policy ----------------------------------------------
# Extra origins allowed for outgoing requests, appended to `connect-src`.
# Widen as integrations land: Supabase (1.6), Stripe (epic 2).
# Example: https://xxxx.supabase.co https://api.stripe.com
#
# Sentry is deliberately absent. The browser's reports go through our own
# domain (`tunnelRoute` in next.config.ts), which puts them out of reach of
# ad blockers — and keeps them inside `connect-src 'self'` without widening
# anything.
CSP_CONNECT_SRC=
