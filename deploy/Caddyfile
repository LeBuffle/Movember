# DEFI Movember — reverse proxy
#
# Caddy obtains and renews TLS certificates on its own; that is why it was
# chosen over Nginx (architecture §2.4). On a project with an immovable
# launch date, certificate handling is time we do not spend.
#
# Variables come from deploy/.env (see .env.example in this directory).

{
	email {$ACME_EMAIL}
}

# Applied to both sites. Kept in one snippet so production and staging can
# never drift apart on security headers.
(security_headers) {
	header {
		# Force HTTPS for a year. `preload` is deliberately omitted: submitting
		# the domain to the preload list is effectively irreversible, and that
		# is a decision for the security review (story 11.8), not a default.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# The app is never meant to be framed.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"

		# Browser features the app has no use for.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

		# Do not advertise the stack.
		-Server
		-X-Powered-By
	}
}

# Content Security Policy.
#
# `unsafe-inline` on scripts and styles is required by Next.js as configured
# today: it emits inline bootstrap scripts and styles without a nonce.
# Tightening this to a nonce-based policy is a deliberate task of the security
# review (story 11.8) — doing it here, blind, would break hydration.
#
# `connect-src` must be widened as integrations land:
#   Supabase (story 1.6), Stripe (epic 2), Sentry (story 1.11).
(csp) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' {$CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}
}

# --- Production -----------------------------------------------------------
{$APP_DOMAIN} {
	import security_headers
	import csp

	encode gzip zstd
	reverse_proxy app:3000

	log {
		output file /var/log/caddy/production.log
		format json
	}
}

# --- Staging --------------------------------------------------------------
#
# Password-protected and excluded from search engines. A test site that takes
# test payments must never be publicly reachable or indexed (story 1.3, AC 8).
{$STAGING_DOMAIN} {
	import security_headers
	import csp

	basic_auth {
		{$STAGING_USER} {$STAGING_PASSWORD_HASH}
	}

	header X-Robots-Tag "noindex, nofollow, noarchive"

	encode gzip zstd
	reverse_proxy app-staging:3000

	log {
		output file /var/log/caddy/staging.log
		format json
	}
}
