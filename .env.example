# DEFI Movember — environment variables
#
# Copy to `.env.local` and fill in the values for your environment.
# NEVER commit a file containing real values: `.env*` is git-ignored except
# for this example (see CLAUDE.md §9).
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Every other variable MUST stay server-side only.

# --- Application ---------------------------------------------------------
# Public base URL, used for OAuth redirects, webhooks and e-mail links.
NEXT_PUBLIC_SITE_URL=
# Injected by the deployment pipeline (commit sha). Optional locally.
APP_VERSION=
# One of: development | staging | production
APP_ENVIRONMENT=

# --- Supabase (story 1.6) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (epic 2) -----------------------------------------------------
# Both are handed over the moment the account is created: Stripe dashboard ->
# Developers -> API keys. In test mode they start with `pk_test_` and
# `sk_test_`.
#
# The publishable key is not read by anything today, and by design: Checkout
# is hosted on Stripe's own pages, so no Stripe code runs in ours and the
# browser only ever receives a URL (NFR14). It is kept because an embedded
# form would need it, and because its absence would be read as an oversight.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The one that matters. Never exposed to the browser, and refused outright by
# the application if a `sk_live_` key turns up outside production.
STRIPE_SECRET_KEY=
# Generated when a webhook endpoint is declared in Stripe, not with the keys
# above. Stripe dashboard -> Developers -> Webhooks -> Add endpoint:
#
#   URL     https://<le-domaine>/api/webhooks/stripe
#   Events  checkout.session.completed
#           checkout.session.async_payment_succeeded
#           charge.refunded          (epic 2, story 2.8)
#
# Then open the endpoint -> "Signing secret" -> Reveal. Starts with `whsec_`.
#
# Each environment declares its own endpoint and gets its own secret: a
# staging secret cannot validate a production call, which is the point.
#
# **Without this value, the webhook refuses every call.** It does not fall
# back to "accept because we cannot verify" — an unverified webhook is a
# route that activates registrations on request.
STRIPE_WEBHOOK_SECRET=

# --- Strava (epic 3) -----------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# --- Web Push (epic 6) ---------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- E-mail (epic 6) -----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# --- Scheduled tasks (story 1.4) -----------------------------------------
# Shared secret required by every /api/cron/* route.
CRON_SECRET=

# --- Encryption (epic 3) -------------------------------------------------
# Key used to encrypt activity-provider tokens at rest.
#
#   openssl rand -hex 32
#
# 64 hexadecimal characters. Without it the application refuses to link a
# sporting account rather than storing a token in clear.
TOKEN_ENCRYPTION_KEY=

# --- Access code for a non-production environment -------------------------
# Turns /acces into the way in to preproduction. Six characters minimum.
#
# Replaces the HTTP password that used to sit on Traefik: an application
# installed on a phone does not share the browser's credential store and has
# no address bar to ask for one, so it answered 401 and stopped there.
#
# **Never set in production.** The check is skipped there whatever this holds,
# but leaving it set is a trap for whoever reads the file next.
ACCESS_CODE=

# --- Monitoring (story 1.11) ---------------------------------------------
# Error reporting. Left empty, Sentry stays completely inert — which is the
# right state in development and until the account exists.
#
# The DSN is public by design: it identifies the project to send to, and can
# do nothing else. That is why it is a NEXT_PUBLIC_ variable, and why the
# same value goes in both places.
NEXT_PUBLIC_SENTRY_DSN=
# Sent along with each report so a stack trace can be attributed to a build.
NEXT_PUBLIC_APP_ENVIRONMENT=

# Build-time only, and genuinely secret: uploads the source maps that turn a
# minified stack trace into a line of our code. Belongs in the GitHub
# secrets, NOT in the server's environment file — the server never builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
