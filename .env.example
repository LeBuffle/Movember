# DEFI Movember — environment variables
#
# Copy to `.env.local` and fill in the values for your environment.
# NEVER commit a file containing real values: `.env*` is git-ignored except
# for this example (see CLAUDE.md §9).
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Every other variable MUST stay server-side only.

# --- Application ---------------------------------------------------------
# Public base URL, used for OAuth redirects, webhooks and e-mail links.
NEXT_PUBLIC_SITE_URL=
# Injected by the deployment pipeline (commit sha). Optional locally.
APP_VERSION=
# One of: development | staging | production
APP_ENVIRONMENT=

# --- Supabase (story 1.6) ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (epic 2) -----------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Strava (epic 3) -----------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# --- Web Push (epic 6) ---------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- E-mail (epic 6) -----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# --- Scheduled tasks (story 1.4) -----------------------------------------
# Shared secret required by every /api/cron/* route.
CRON_SECRET=

# --- Encryption (epic 3) -------------------------------------------------
# Key used to encrypt activity-provider tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- Monitoring (story 1.11) ---------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
